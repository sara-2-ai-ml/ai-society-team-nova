PORT=3000

# Change this to a long random string
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Password for the seeded users (operator, drejtoria, kryetari). Dev only.
SEED_PASSWORD=nova123

# Python service (real data + AI agent): cd to the repo root and run
#   .venv/Scripts/python -m uvicorn backend.main:app --port 8000
PYTHON_API_URL=http://127.0.0.1:8000/api

# AI (OpenAI). Paste your key here (starts with sk-). Leave empty to run without AI:
# the assistant and the reports then answer from rules over the same data.
OPENAI_API_KEY=
# Hackathon keys go through the organisers' address (from the AI4Society key guide).
# Remove this line to use a normal key directly with OpenAI.
OPENAI_BASE_URL=https://llm.mjovanovic.dev/v1
OPENAI_MODEL=gpt-5-mini
